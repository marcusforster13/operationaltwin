{
  "name": "operational-twin-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/check-assets.mjs && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "build:remote": "node scripts/check-assets.mjs --require-remote && npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "esbuild": "npm:esbuild-wasm@0.28.2",
    "meshoptimizer": "0.22.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@0.28.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
